---
// Closing contact block used across the live site ("Ready to begin your healing journey?"):
// heading and the three ways to connect on the left, the full vertical form on the right.
import ContactForm from './mdx/ContactForm.astro';
import Lotus from '../assets/lotus.svg';
import { practice } from '../data/site';
interface Props { intro?: string }
const { intro } = Astro.props;
---
<section class="section section-dark ready texture" aria-labelledby="ready-heading">
  <Lotus class="lotus-mark ready-lotus" aria-hidden="true" />
  <div class="wrap ready-grid">
    <div class="ready-copy">
      <div class="ready-head" data-reveal>
        <h2 id="ready-heading">Ready to begin your <em>healing journey?</em></h2>
        {intro && intro.split(/\n\n+/).map((p) => <p>{p}</p>)}
        <p>For the fastest way to connect you can:</p>
      </div>
      <ol class="steps" data-stagger>
        <li data-reveal>
          <span class="n" aria-hidden="true">1</span>
          <div><strong>Give Us A Call</strong><a class="step-link" href={practice.phoneHref}>Call Us {practice.phone}</a></div>
        </li>
        <li data-reveal>
          <span class="n" aria-hidden="true">2</span>
          <div><strong>Send Us a Quick Message:</strong> Please fill out the form to contact us with any questions, request a free consultation, or to make an appointment request.</div>
        </li>
        <li data-reveal>
          <span class="n" aria-hidden="true">3</span>
          <div><strong>Schedule A Free Call with Our Client Care Team</strong><a class="btn btn-primary" href={practice.bookingUrl} data-cta="consultation">Book A Free Consult</a></div>
        </li>
      </ol>
    </div>
    <div class="ready-form" data-reveal="right"><ContactForm heading="Send us a message" layout="stacked" /></div>
  </div>
</section>

<style>
  .ready-lotus { right: -5rem; top: -4rem; color: #fff; opacity: 0.06; }
  .ready-grid { display: grid; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  @media (min-width: 62rem) { .ready-grid { grid-template-columns: 1fr 1.1fr; } }
  .ready-head { margin-bottom: 1.75rem; }
  .ready-head h2 { margin-bottom: 0.4em; }
  .ready-head p { margin-bottom: 0.4rem; }
  .steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.9rem; }
  .steps li { display: grid; grid-template-columns: 2.4rem 1fr; gap: 0.9rem; margin: 0; align-items: start; padding: 1.1rem 1.2rem; border-radius: var(--radius); background: rgb(255 255 255 / 0.06); border: 1px solid rgb(255 255 255 / 0.14); font-size: 0.95rem; transition: background-color 0.3s, transform 0.4s var(--ease); }
  .steps li:hover { background: rgb(255 255 255 / 0.1); transform: translateX(4px); }
  .n { display: grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 50%; font-family: var(--font-display); font-size: 1.1rem; color: var(--forest-900); background: var(--gold); }
  .steps strong { color: #fff; }
  .step-link { display: block; width: fit-content; margin-top: 0.25rem; font-family: var(--font-display); font-size: 1.25rem; text-decoration: none; }
  .step-link:hover { color: var(--gold) !important; }
  .steps .btn { display: flex; width: fit-content; margin-top: 0.6rem; min-height: 2.7rem; padding: 0.55rem 1.1rem; font-size: 0.93rem; }
  .ready-form :global(.contact-form) { margin: 0; max-width: none; box-shadow: var(--shadow-lg); }
  .ready-form :global(.cf-heading) { color: var(--ink); }
</style>
