---
// Slow, decorative scrolling band of service names. Pauses on hover; static for reduced motion.
// The names are links so the band is useful, not only decorative.
import Lotus from '../assets/lotus.svg';
import { getServices } from '../lib/content';
const services = await getServices();
---
<nav class="ticker" aria-label="Specialties and approaches">
  <div class="track">
    {[0, 1].map((copy) => (
      <ul aria-hidden={copy === 1 ? 'true' : undefined}>
        {services.map((s) => (
          <li><a href={`/${s.id}/`} tabindex={copy === 1 ? -1 : undefined}>{s.data.navLabel}</a><Lotus class="sep" aria-hidden="true" /></li>
        ))}
      </ul>
    ))}
  </div>
</nav>

<style>
  .ticker { overflow: hidden; background: var(--rose); color: #fff; padding-block: 1rem; mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  .track { display: flex; width: max-content; }
  .ticker ul { display: flex; align-items: center; list-style: none; margin: 0; padding: 0; }
  .ticker li { display: flex; align-items: center; margin: 0; white-space: nowrap; }
  .ticker a { color: #fff; text-decoration: none; font-family: var(--font-display); font-style: italic; font-size: clamp(1.2rem, 1rem + 0.8vw, 1.7rem); padding-inline: 1.4rem; }
  .ticker a:hover { color: var(--gold); }
  .sep { width: 1.8rem; height: auto; color: #fff; opacity: 0.7; }
  @media (prefers-reduced-motion: no-preference) {
    .track { animation: marquee 60s linear infinite; }
    .ticker:hover .track, .ticker:focus-within .track { animation-play-state: paused; }
  }
  @keyframes marquee { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .ticker ul:nth-child(2) { display: none; } .track { flex-wrap: wrap; width: auto; justify-content: center; } }
</style>
