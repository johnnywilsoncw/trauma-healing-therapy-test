---
// Full-bleed photo hero with a soft evergreen overlay. Not full-screen: the next section stays in view.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Lotus from '../assets/lotus.svg';
import CtaPair from './mdx/CtaPair.astro';

interface Props {
  eyebrow?: string;
  kicker?: string;
  title: string;
  subtitle?: string;
  image: ImageMetadata;
  chips?: string[];
  ctas?: boolean;
  crumbs?: { label: string; href?: string }[];
  size?: 'lg' | 'md';
}
const { eyebrow, kicker, title, subtitle, image, chips = [], ctas = true, crumbs, size = 'md' } = Astro.props;
---
<section class:list={['phero', `phero-${size}`, 'on-dark']}>
  <div class="phero-bg" aria-hidden="true">
    <Picture src={image} alt="" widths={[640, 1024, 1600, 2000]} sizes="100vw" formats={['avif', 'webp']} loading="eager" fetchpriority="high" />
  </div>
  <Lotus class="phero-lotus" aria-hidden="true" />
  <div class="wrap phero-inner">
    {crumbs && (
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>{crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}</ol>
      </nav>
    )}
    {eyebrow && <p class="eyebrow phero-anim" style="--i:0">{eyebrow}</p>}
    {kicker && <p class="phero-kicker phero-anim" style="--i:0"><span>{kicker}</span></p>}
    <h1 class="phero-anim" style="--i:1" set:html={title} />
    {subtitle && <p class="phero-sub phero-anim" style="--i:2">{subtitle}</p>}
    <div class="phero-anim" style="--i:3"><slot /></div>
    {chips.length > 0 && <ul class="chips phero-anim" style="--i:3">{chips.map((c) => <li>{c}</li>)}</ul>}
    {ctas && <div class="phero-anim" style="--i:4"><CtaPair /></div>}
  </div>
  <svg class="phero-wave" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true"><path d="M0 48c180 26 360 34 540 22S900 22 1080 20s300 16 360 24v36H0z" /></svg>
</section>

<style>
  .phero { position: relative; isolation: isolate; color: #fff; overflow: hidden; display: flex; align-items: center; }
  .phero-md { min-height: clamp(20rem, 44vh, 27rem); }
  .phero-lg { min-height: clamp(28rem, 66vh, 38rem); }
  .phero-bg { position: absolute; inset: 0; z-index: -2; }
  .phero-bg :global(picture), .phero-bg :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 70% 35%; }
  @media (prefers-reduced-motion: no-preference) { .phero-bg :global(img) { animation: kenburns 22s ease-out both; } }
  @keyframes kenburns { from { transform: scale(1.12); } to { transform: scale(1); } }
  .phero::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(95deg, rgb(12 34 27 / 0.92) 0%, rgb(15 42 33 / 0.78) 38%, rgb(15 42 33 / 0.25) 70%, rgb(15 42 33 / 0.05) 100%),
      linear-gradient(0deg, rgb(12 34 27 / 0.55), transparent 45%);
  }
  @media (max-width: 48rem) { .phero::before { background: linear-gradient(0deg, rgb(12 34 27 / 0.92) 10%, rgb(15 42 33 / 0.72) 60%, rgb(15 42 33 / 0.45)); } }
  .phero-lotus { position: absolute; z-index: -1; left: -5rem; bottom: -4rem; width: clamp(18rem, 34vw, 30rem); height: auto; color: #fff; opacity: 0.06; }
  .phero-inner { padding-block: clamp(2.5rem, 5vw, 4rem) clamp(3.5rem, 6vw, 5rem); }
  .phero-inner > * { max-width: 42rem; }
  .phero h1 { color: #fff; margin-bottom: 0.35em; }
  .phero h1 :global(em) { color: var(--gold); }
  .phero-kicker { display: flex; align-items: center; gap: 1rem; margin: 0 0 0.9rem; font-family: var(--font-display); font-style: italic; font-weight: 400; font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.4rem); line-height: 1.1; color: #f6d9e1 !important; }
  .phero-kicker::after { content: ''; flex: 0 0 auto; width: clamp(3rem, 8vw, 6rem); height: 2px; border-radius: 2px; background: linear-gradient(90deg, var(--gold), transparent); }
  .phero-kicker span { background: linear-gradient(90deg, #fff 0%, #f6d9e1 60%, var(--gold) 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .phero-sub { font-family: var(--font-display); font-style: italic; font-size: clamp(1.15rem, 1rem + 0.6vw, 1.5rem); color: #f3dfe5; line-height: 1.35; }
  .phero :global(p) { color: #e3ece7; }
  .phero :global(a:not(.btn)) { color: #fff; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; padding: 0; margin: 1.25rem 0 0; }
  .chips li { margin: 0; padding: 0.4rem 0.9rem; border-radius: 999px; font-size: 0.9rem; font-weight: 600; background: rgb(255 255 255 / 0.12); border: 1px solid rgb(255 255 255 / 0.28); backdrop-filter: blur(6px); }
  .chips li::before { content: '✓'; margin-right: 0.45rem; color: var(--gold); }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; padding: 0; margin: 0 0 1.5rem; font-size: 0.88rem; }
  .crumbs li { margin: 0; color: rgb(255 255 255 / 0.75); }
  .crumbs li + li::before { content: '/'; margin-right: 0.4rem; opacity: 0.5; }
  .crumbs a { color: rgb(255 255 255 / 0.85); text-decoration: none; }
  .crumbs a:hover { color: #fff; text-decoration: underline; }
  .phero-wave { position: absolute; left: 0; right: 0; bottom: -1px; width: 100%; height: clamp(2.5rem, 5vw, 4.5rem); fill: var(--wave, var(--paper)); }
  @media (prefers-reduced-motion: no-preference) {
    .phero-anim { animation: rise 1s var(--ease) both; animation-delay: calc(var(--i) * 0.12s + 0.1s); }
  }
  @keyframes rise { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
</style>
