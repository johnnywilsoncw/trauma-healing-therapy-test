---
// Three posts in a grid: this service's own posts first (by explicit category), then the
// most recent posts from the rest of the blog so the row is always full.
import PostCard from './PostCard.astro';
import { getPosts } from '../lib/content';
interface Props { serviceId: string; heading?: string }
const { serviceId, heading = 'From Our Blog' } = Astro.props;
const all = await getPosts();
const posts = [...all.filter((p) => p.data.category.id === serviceId), ...all.filter((p) => p.data.category.id !== serviceId)].slice(0, 3);
---
{posts.length > 0 && (
  <section class="section section-sand" aria-labelledby={`posts-${serviceId}`}>
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Keep reading</p>
        <h2 id={`posts-${serviceId}`}>{heading}</h2>
      </div>
      <ul class="grid-cards posts-3">{posts.map((p) => <PostCard post={p} />)}</ul>
    </div>
  </section>
)}

<style>
  @media (min-width: 56rem) { .posts-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
