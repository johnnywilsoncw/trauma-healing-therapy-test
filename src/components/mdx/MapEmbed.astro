---
// Google Business Profile map, lazy-loaded below the fold. The embed has its own "open in Maps" control.
import { offices, fullAddress, type OfficeId } from '../../data/site';
interface Props { office: OfficeId }
const o = offices[Astro.props.office];
---
<div class="map">
  <iframe src={o.mapEmbed} title={`Map: ${o.name}, ${fullAddress(o.id)}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
</div>

<style>
  .map { margin: 1rem 0 1.5rem; }
  .map iframe { display: block; width: 100%; aspect-ratio: 4 / 3; max-height: 22rem; border: 0; border-radius: var(--radius-lg); background: var(--sage); }
</style>
