---
// Responsive grid of <InfoCard> / <FeeCard> items inside MDX.
interface Props { cols?: 2 | 3 }
const { cols = 3 } = Astro.props;
---
<div class:list={['card-grid', `cols-${cols}`]} data-stagger><slot /></div>

<style>
  .card-grid { display: grid; gap: clamp(1rem, 2vw, 1.5rem); margin: 1.5rem 0; grid-template-columns: 1fr; }
  @media (min-width: 48rem) { .cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); } .cols-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
