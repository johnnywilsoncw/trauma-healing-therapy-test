---
// One question/answer, rendered as an accessible disclosure (no JavaScript needed).
interface Props { question: string }
---
<details class="faq">
  <summary><span class="faq-q">{Astro.props.question}</span><span class="faq-icon" aria-hidden="true"></span></summary>
  <div class="faq-body"><slot /></div>
</details>

<style>
  .faq { border: 1px solid rgb(15 42 33 / 0.1); border-radius: var(--radius); background: rgb(255 255 255 / 0.85); margin: 0 0 0.8rem; color: var(--ink); transition: box-shadow 0.3s var(--ease), border-color 0.3s; }
  .faq:hover { box-shadow: var(--shadow-sm); }
  .faq[open] { border-color: rgb(176 54 90 / 0.35); box-shadow: var(--shadow); background: #fff; }
  .faq summary { cursor: pointer; list-style: none; display: flex; align-items: center; gap: 1rem; justify-content: space-between; padding: 1.15rem 1.35rem; font-weight: 650; font-size: 1.05rem; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq-icon { position: relative; flex: 0 0 2rem; height: 2rem; border-radius: 50%; background: var(--forest-50); transition: background-color 0.3s, transform 0.4s var(--ease); }
  .faq-icon::before, .faq-icon::after { content: ''; position: absolute; left: 50%; top: 50%; width: 0.8rem; height: 2px; background: var(--forest); border-radius: 2px; transform: translate(-50%, -50%); }
  .faq-icon::after { transform: translate(-50%, -50%) rotate(90deg); transition: transform 0.4s var(--ease); }
  .faq[open] .faq-icon { background: var(--rose); transform: rotate(180deg); }
  .faq[open] .faq-icon::before { background: #fff; }
  .faq[open] .faq-icon::after { transform: translate(-50%, -50%) rotate(0deg); background: #fff; }
  .faq-body { padding: 0 1.35rem 0.6rem; color: var(--ink-soft); }
  .faq[open] .faq-body { animation: faq-in 0.45s var(--ease); }
  @keyframes faq-in { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
</style>
