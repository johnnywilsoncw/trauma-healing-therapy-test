---
// Simple inquiry form. The backend is intentionally NOT chosen yet: set PUBLIC_FORM_ENDPOINT
// to an approved provider's POST endpoint (for example a HIPAA-appropriate form service).
// Until then the form renders for preview, submission is disabled, and visitors are
// pointed to the phone number and booking link. No success message is ever faked.
//
// layout="horizontal": one row (name, email, phone, message, submit) for bands on content pages.
// layout="stacked":    the fuller vertical form used on the contact, office and geo pages.
import { practice, FORM_ENDPOINT } from '../../data/site';

interface Props { heading?: string; compact?: boolean; layout?: 'stacked' | 'horizontal'; messageRows?: number }
const { heading, compact = false, layout = 'horizontal', messageRows = 4 } = Astro.props;
const uid = `cf-${Math.random().toString(36).slice(2, 8)}`;
const connected = Boolean(FORM_ENDPOINT);
const horizontal = layout === 'horizontal';
---
<div class:list={['contact-form', `cf-${layout}`, { compact }]}>
  {heading && <h2 class="cf-heading">{heading}</h2>}
  <form
    method="post"
    action={FORM_ENDPOINT ?? '#'}
    novalidate
    data-contact-form
    data-connected={connected ? 'true' : 'false'}
    aria-describedby={`${uid}-privacy`}
  >
    <div class="cf-grid">
      <div class="field">
        <label for={`${uid}-name`}>Name <span aria-hidden="true">*</span></label>
        <input id={`${uid}-name`} name="name" type="text" autocomplete="name" required aria-describedby={`${uid}-name-err`} />
        <p class="err" id={`${uid}-name-err`} hidden>Please enter your name.</p>
      </div>
      <div class="field">
        <label for={`${uid}-email`}>Email <span aria-hidden="true">*</span></label>
        <input id={`${uid}-email`} name="email" type="email" autocomplete="email" required aria-describedby={`${uid}-email-err`} />
        <p class="err" id={`${uid}-email-err`} hidden>Please enter a valid email address.</p>
      </div>
      <div class="field">
        <label for={`${uid}-phone`}>Phone</label>
        <input id={`${uid}-phone`} name="phone" type="tel" autocomplete="tel" />
      </div>
      {!horizontal && (
        <div class="field">
          <label for={`${uid}-source`}>How did you hear about us?</label>
          <input id={`${uid}-source`} name="source" type="text" />
        </div>
      )}
      <div class="field field-msg">
        <label for={`${uid}-message`}>Message <span aria-hidden="true">*</span></label>
        {horizontal
          ? <input id={`${uid}-message`} name="message" type="text" required aria-describedby={`${uid}-message-err`} />
          : <textarea id={`${uid}-message`} name="message" rows={messageRows} required aria-describedby={`${uid}-message-err`}></textarea>}
        <p class="err" id={`${uid}-message-err`} hidden>Please add a brief message.</p>
      </div>
      <div class="hp" aria-hidden="true">
        <label for={`${uid}-website`}>Leave this field empty</label>
        <input id={`${uid}-website`} name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <div class="field field-submit">
        <button class="cf-submit" type="submit" disabled={!connected} aria-describedby={connected ? undefined : `${uid}-offline`}>Submit</button>
      </div>
    </div>
    {!connected && (
      <p class="cf-offline" id={`${uid}-offline`} role="note">
        Online messages are not connected yet. Please call <a href={practice.phoneHref}>{practice.phone}</a> or
        <a href={practice.bookingUrl}>book a free consultation</a>.
      </p>
    )}
    <p class="cf-privacy" id={`${uid}-privacy`}>
      Please keep this message brief and avoid sharing detailed health information. {practice.responseTime}
      This form is not for emergencies. If you are in crisis, call 911 or call or text 988.
    </p>
    <p class="cf-status" role="status" aria-live="polite"></p>
  </form>
  <p class="cf-oon">
    We’re an out-of-network provider, but many clients are eligible for OON reimbursement—check your benefits
    <a href={practice.mentayaUrl} rel="noopener"><strong>HERE</strong><span class="visually-hidden"> (Mentaya benefits check)</span></a>
  </p>
</div>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-contact-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('.cf-status')!;
    const validate = () => {
      let firstBad: HTMLInputElement | HTMLTextAreaElement | null = null;
      form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]').forEach((el) => {
        const bad = !el.value.trim() || (el.type === 'email' && !el.validity.valid);
        el.setAttribute('aria-invalid', String(bad));
        const err = document.getElementById(`${el.id}-err`);
        if (err) err.hidden = !bad;
        if (bad && !firstBad) firstBad = el;
      });
      (firstBad as HTMLElement | null)?.focus();
      return !firstBad;
    };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (form.dataset.connected !== 'true') return;
      if (!validate()) return;
      const button = form.querySelector<HTMLButtonElement>('button[type=submit]');
      button?.setAttribute('disabled', '');
      status.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.textContent = 'Thank you for reaching out! Our team will be with you shortly.';
      } catch {
        status.textContent = 'Sorry, your message could not be sent. Please call us or try again.';
      } finally {
        button?.removeAttribute('disabled');
      }
    });
  });
</script>

<style>
  .contact-form { color: var(--ink); }
  .field label { display: block; font-weight: 600; font-size: 0.95rem; margin-bottom: 0.35rem; }
  .field input, .field textarea { width: 100%; font: inherit; padding: 0.75rem 0.9rem; border: 1px solid #76887f; border-radius: 12px; background: var(--paper); color: var(--ink); }
  .field input:focus-visible, .field textarea:focus-visible { outline: 3px solid var(--focus); outline-offset: 1px; }
  [aria-invalid='true'] { border-color: #a3263f !important; }
  .err { color: #a3263f; font-size: 0.88rem; margin: 0.3rem 0 0; }
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .cf-submit { width: 100%; min-height: 3.1rem; padding: 0.75rem 1.5rem; border: 0; border-radius: 12px; font: 700 1rem var(--font-body); color: #fff; background: var(--forest); cursor: pointer; transition: background-color 0.2s, transform 0.3s var(--ease); }
  .cf-submit:hover:not(:disabled) { background: var(--forest-700); transform: translateY(-2px); }
  .cf-submit:disabled { cursor: not-allowed; opacity: 0.55; }
  .cf-status:empty { display: none; }
  .cf-status { margin-top: 1rem; font-weight: 600; }

  /* stacked card (contact, office and geo pages) */
  .cf-stacked { background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg); padding: clamp(1.25rem, 3vw, 2rem); box-shadow: var(--shadow); margin: 2rem 0; max-width: 46rem; }
  .cf-heading { font-size: clamp(1.35rem, 1.2rem + 0.6vw, 1.75rem); margin-top: 0 !important; }
  .cf-stacked .cf-grid { display: grid; gap: 1rem; }
  @media (min-width: 40rem) { .cf-stacked .cf-grid { grid-template-columns: 1fr 1fr; } .cf-stacked .field-msg, .cf-stacked .field-submit { grid-column: 1 / -1; } .cf-stacked .field-submit { justify-self: start; } .cf-stacked .cf-submit { width: auto; } }
  .cf-stacked .cf-privacy { font-size: 0.85rem; color: var(--ink-soft); margin: 1rem 0 0; }
  .cf-stacked .cf-offline { background: var(--rose-50); border-left: 4px solid var(--rose); padding: 0.7rem 1rem; border-radius: 8px; font-size: 0.93rem; margin: 1rem 0 0; }
  .cf-stacked .cf-oon { font-size: 0.9rem; margin: 1rem 0 0; color: var(--ink-soft); }

  /* horizontal row (bands on content pages) */
  .cf-horizontal { width: 100%; }
  .cf-horizontal .cf-grid { display: grid; gap: 1rem; grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .cf-horizontal .cf-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 64rem) { .cf-horizontal .cf-grid { grid-template-columns: repeat(4, minmax(0, 1fr)) auto; align-items: end; } }
  .cf-horizontal .field-submit .cf-submit { min-width: 8rem; }
  .cf-horizontal .field input { min-height: 3.1rem; }
  .cf-horizontal .cf-offline, .cf-horizontal .cf-privacy, .cf-horizontal .cf-oon { font-size: 0.85rem; margin: 0.9rem 0 0; text-align: center; }
  .cf-horizontal .cf-offline { font-weight: 600; }
  /* on dark bands */
  :global(:is(.section-dark, .on-dark)) .cf-horizontal { color: #e8f0eb; }
  :global(:is(.section-dark, .on-dark)) .cf-horizontal label { color: #fff; }
  :global(:is(.section-dark, .on-dark)) .cf-horizontal .field input { background: rgb(255 255 255 / 0.94); border-color: transparent; }
  :global(:is(.section-dark, .on-dark)) .cf-horizontal .cf-submit { background: #fff; color: var(--forest-900); }
  :global(:is(.section-dark, .on-dark)) .cf-horizontal .cf-submit:hover:not(:disabled) { background: var(--gold); }
  :global(:is(.section-dark, .on-dark)) .cf-horizontal a:not(.btn) { color: #fff !important; }
  :global(:is(.section-dark, .on-dark)) .cf-horizontal .err { color: #ffc2cf; }
</style>
