---
import { render, getEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import ReadyToBegin from '../components/ReadyToBegin.astro';
import PostCard from '../components/PostCard.astro';
import { mdxComponents } from '../components/mdx';
import { SITE_URL, practice } from '../data/site';
import { clinicianName, getPosts, type Post } from '../lib/content';
import { articleSchema } from '../lib/schema';

interface Props { entry: Post }
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const author = (await getEntry(d.author))!;
const service = (await getEntry(d.category))!;
const authorName = clinicianName(author);
const url = `${SITE_URL}/${entry.id}/`;
const share = d.heroImage ? await getImage({ src: d.heroImage, width: 1200, format: 'jpg' }) : undefined;
const it = d.lang === 'it';
const words = (entry.body ?? '').split(/\s+/).length;
const minutes = Math.max(1, Math.round(words / 230));
const more = (await getPosts()).filter((p) => p.id !== entry.id).slice(0, 3);
---
<BaseLayout
  title={`${d.title} | Trauma Healing Therapy`}
  description={d.description}
  image={d.heroImage}
  type="article"
  lang={d.lang}
  schema={[articleSchema({ url, headline: d.title, description: d.description, image: share && new URL(share.src, SITE_URL).href, published: d.published, updated: d.updated, authorSlug: author.data.path, authorName, lang: d.lang })]}
>
  <div class="progress" aria-hidden="true"><span></span></div>
  <article>
    <header class="post-head">
      <div class="wrap head-grid">
        <div class="head-copy">
          <p class="eyebrow"><a href={`/${service.id}/`}>{service.data.navLabel}</a></p>
          <h1>{d.title}</h1>
          <div class="byline">
            <Image class="avatar" src={author.data.photo} alt="" width={96} height={96} />
            <p>
              {it ? 'Di' : 'By'} <a href={`/${author.data.path}/`}>{authorName}</a><br />
              <span class="meta">{minutes} {it ? 'min di lettura' : 'min read'}</span>
            </p>
          </div>
        </div>
        {d.heroImage && (
          <div class="head-img">
            <Image src={d.heroImage} alt={d.heroAlt ?? ''} width={900} widths={[480, 800, 1100]} sizes="(min-width: 60rem) 34rem, 100vw" loading="eager" fetchpriority="high" />
          </div>
        )}
      </div>
    </header>

    <div class="section post-section">
      <div class="wrap post-layout">
        <div class="prose post-body">
          <Content components={mdxComponents} />
          <p class="btn-row"><a class="btn btn-primary" href="/contact-us/">{it ? 'Contattaci' : 'Contact Us'}</a></p>
        </div>
        <aside class="post-aside" aria-label="About this article">
          <div class="card aside-card service-card">
            <p class="a-label">{it ? 'Argomento' : 'Related service'}</p>
            <p class="a-title">{service.data.navLabel}</p>
            {service.data.card && <Image src={service.data.card.image} alt="" width={480} height={300} class="a-img" />}
            <a class="btn btn-secondary a-btn" href={`/${service.id}/`}>{it ? 'Scopri di più' : `Learn about ${service.data.navLabel}`}</a>
          </div>
          <div class="card aside-card consult">
            <p class="a-title">{it ? 'Pronto per iniziare?' : 'Ready to talk?'}</p>
            <p>{it ? 'Prenota una consulenza gratuita con il nostro team.' : 'Book a free consultation with our client care team.'}</p>
            <a class="btn btn-primary a-btn" href={practice.bookingUrl}>Free Consultation</a>
            <a class="a-phone" href={practice.phoneHref}>{practice.phone}</a>
          </div>
        </aside>
      </div>
    </div>
  </article>

  {more.length > 0 && (
    <section class="section section-sand" aria-labelledby="more-heading">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Keep reading</p>
          <h2 id="more-heading">More from the <em>blog</em></h2>
        </div>
        <ul class="grid-cards">{more.map((p) => <PostCard post={p} />)}</ul>
      </div>
    </section>
  )}
  <ReadyToBegin />
</BaseLayout>

<script>
  // Reading progress bar (decorative).
  const bar = document.querySelector<HTMLElement>('.progress span');
  const art = document.querySelector<HTMLElement>('.post-body');
  if (bar && art) {
    const update = () => {
      const r = art.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight - r.top) / (r.height + innerHeight * 0.5)));
      bar.style.transform = `scaleX(${p})`;
    };
    update();
    addEventListener('scroll', update, { passive: true });
  }
</script>

<style>
  .progress { position: fixed; top: 0; left: 0; right: 0; height: 4px; z-index: 60; }
  .progress span { display: block; height: 100%; background: linear-gradient(90deg, var(--forest), var(--rose)); transform: scaleX(0); transform-origin: left; }
  .post-head { position: relative; overflow: hidden; background: linear-gradient(160deg, var(--forest-50), var(--paper) 55%, var(--rose-50)); padding-block: clamp(2.5rem, 6vw, 5rem); }
  .head-grid { display: grid; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  @media (min-width: 60rem) { .head-grid { grid-template-columns: 1.1fr 0.9fr; } }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; padding: 0; margin: 0 0 1.25rem; font-size: 0.88rem; }
  .crumbs li { margin: 0; color: var(--ink-soft); }
  .crumbs li + li::before { content: '/'; margin-right: 0.4rem; opacity: 0.5; }
  .crumbs a { color: var(--ink-soft); text-decoration: none; }
  .crumbs a:hover { color: var(--rose); }
  .eyebrow a { color: inherit; text-decoration: none; }
  
  .byline { display: flex; align-items: center; gap: 0.9rem; margin-top: 1.5rem; }
  .byline p { margin: 0; line-height: 1.4; font-weight: 600; }
  .byline :global(.avatar) { width: 3.4rem; height: 3.4rem; border-radius: 50%; object-fit: cover; object-position: top; box-shadow: 0 0 0 3px #fff, var(--shadow-sm); }
  .meta { font-weight: 400; font-size: 0.9rem; color: var(--ink-soft); }
  .head-img :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius-lg) var(--radius-lg) var(--radius-lg) 160px; box-shadow: var(--shadow-lg); }
  .post-layout { display: grid; gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  @media (min-width: 62rem) { .post-layout { grid-template-columns: minmax(0, 1fr) 19rem; } .post-aside { position: sticky; top: 7rem; } }
  .post-body { max-width: 42rem; }
  .post-body > :global(p:first-child) { font-size: 1.25rem; line-height: 1.65; color: var(--ink); }
  .post-body > :global(p:first-child)::first-letter { float: left; font-family: var(--font-display); font-size: 4.2rem; line-height: 0.85; padding: 0.35rem 0.6rem 0 0; color: var(--rose); }
  .post-body :global(h2) { padding-top: 0.5rem; }
  .post-aside { display: grid; gap: 1.25rem; }
  .aside-card { padding: 1.5rem; }
  .a-label { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--rose); margin-bottom: 0.3rem; }
  .a-title { font-family: var(--font-display); font-size: 1.4rem; line-height: 1.2; margin-bottom: 0.8rem; }
  .aside-card :global(.a-img) { display: block; width: 100%; height: auto; border-radius: var(--radius); margin-bottom: 1rem; }
  .a-btn { width: 100%; }
  .consult { background: radial-gradient(120% 140% at 0% 0%, #2a6a53 0%, var(--forest) 45%, var(--forest-900) 100%); color: #e8f0eb; border: 0; }
  .consult .a-title { color: #fff; }
  .consult .btn-primary { --btn-bg: #fff; --btn-fg: var(--forest-700); --btn-bd: #fff; }
  .a-phone { display: block; text-align: center; margin-top: 0.75rem; color: #fff; font-weight: 600; }
</style>
