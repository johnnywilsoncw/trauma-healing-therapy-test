---
// An actual office page. Office facts come from src/data/site.ts; directions from the MDX body.
import { render, getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ContactWelcome from '../components/ContactWelcome.astro';
import YouTube from '../components/mdx/YouTube.astro';
import MapEmbed from '../components/mdx/MapEmbed.astro';
import { mdxComponents } from '../components/mdx';
import { offices, fullAddress, practice, type OfficeId } from '../data/site';
import { officeSchema } from '../lib/schema';


interface Props { entry: CollectionEntry<'locations'> }
const { entry } = Astro.props;
const d = entry.data;
const id = entry.id as OfficeId;
const o = offices[id];
const { Content } = await render(entry);
// Geo pages are served from the Cupertino office, so they are linked from there.
const geo = id === 'cupertino' ? (await getCollection('geo')).filter((g) => !g.data.draft).sort((a, b) => a.data.city.localeCompare(b.data.city)) : [];
---
<BaseLayout title={d.title} description={d.description} schema={[officeSchema(id)]}>
  <ContactWelcome title={d.h1} subline={`${fullAddress(id)} (${o.availability})`}video={d.welcomeVideo} matchingCopy={id === 'san-francisco' ? 'snow' : 'team'} />

  <section class="section section-tint" aria-labelledby="office-heading">
    <div class="wrap office-grid">
      <div>
        <h2 id="office-heading">{id === 'cupertino' ? 'Our Cupertino Office' : 'Our San Francisco Office (Online Only)'}</h2>
        <p><strong>Address</strong><br />{fullAddress(id)}</p>
        <p><strong>Hours</strong><br />{o.hours}</p>
        <p><strong>Phone</strong><br /><a href={practice.phoneHref}>{practice.phone}</a></p>
        {!o.inPerson && <p class="online-note">Appointments for this office are online only. In-person sessions are available at our Cupertino office.</p>}
        {d.officeVideo && <YouTube id={d.officeVideo} title="A look at our Cupertino office" />}
      </div>
      <MapEmbed office={id} />
    </div>
  </section>

  <section class="section" aria-labelledby="directions-heading">
    <div class="wrap-narrow prose">
      <h2 id="directions-heading">Directions</h2>
      <Content components={mdxComponents} />
    </div>
  </section>

  {geo.length > 0 && (
    <section class="section section-sand" aria-labelledby="areas-heading">
      <div class="wrap">
        <h2 id="areas-heading">Communities We Serve From Our Cupertino Office</h2>
        <ul class="areas">
          {geo.map((g) => <li><a href={`/${g.id}/`}>{`Therapy for residents in ${g.data.city}, CA`}</a></li>)}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .office-grid { display: grid; gap: 2rem; align-items: start; }
  @media (min-width: 56rem) { .office-grid { grid-template-columns: 1fr 1.2fr; } }
  .online-note { background: #fff; border-left: 4px solid var(--rose); padding: 0.75rem 1rem; border-radius: 8px; }
  .areas { display: grid; gap: 0.5rem 2rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); padding-left: 1.2em; }
</style>
