---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ReadyToBegin from '../components/ReadyToBegin.astro';
import { mdxComponents } from '../components/mdx';
import testimonialsBanner from '../assets/wp/2024/05/Testimonials-Banner-1.jpg';

interface Props { entry: CollectionEntry<'pages'> }
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const legal = d.group === 'legal';
const image = entry.id === 'testimonials' ? testimonialsBanner : undefined;
---
<BaseLayout title={d.title} description={d.description} noindex={d.noindex}>
  <Hero title={d.h1} ctas={!legal} image={image} />
  <div class="section">
    <article class="wrap-narrow prose">
      <Content components={mdxComponents} />
    </article>
  </div>
  {!legal && <ReadyToBegin />}
</BaseLayout>
