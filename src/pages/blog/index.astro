---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SoftHero from '../../components/SoftHero.astro';
import PostCard from '../../components/PostCard.astro';
import ReadyToBegin from '../../components/ReadyToBegin.astro';
import { getPosts } from '../../lib/content';

const posts = await getPosts();
---
<BaseLayout
  title="Blog | Trauma Healing Therapy"
  description="Articles from Trauma Healing Therapy on trauma, EMDR, relationships, teens, ADHD, anxiety and healing, for readers in Cupertino, San Francisco and across California."
>
  <SoftHero eyebrow="Resources" title="The <em>Blog</em>" lede="Articles on trauma, relationships, teens, ADHD, anxiety and healing from the Trauma Healing Therapy team." />

  <section class="section blog" aria-label="Articles">
    <div class="wrap">
      <ul class="grid-cards posts">
        {posts.map((p) => <PostCard post={p} headingLevel="h2" />)}
      </ul>
    </div>
  </section>
  <ReadyToBegin />
</BaseLayout>

<style>
  .blog { padding-top: clamp(2.5rem, 5vw, 4rem); }
  .posts { grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
</style>
