# Copy to .env for local testing. In Vercel, set these under Project → Settings → Environment Variables.
# Only PUBLIC_* values are exposed to the browser; never put secrets in them.

# Form provider POST endpoint (NOT CHOSEN YET – launch blocker). Leave empty until an
# approved, appropriate provider (e.g. HIPAAtizer or another BAA-backed service) is configured.
PUBLIC_FORM_ENDPOINT=

# Google Tag Manager container. Defaults to GTM-5956LCKN (found on the live site) when unset.
# Set to "none" to disable. GTM only loads on production builds (VERCEL_ENV=production).
PUBLIC_GTM_ID=

# Vercel sets VERCEL_ENV automatically. For a non-Vercel production build, set SITE_INDEXABLE=true.
SITE_INDEXABLE=
